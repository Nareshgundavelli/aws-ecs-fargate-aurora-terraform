# CloudMart Backend Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# Aurora MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudmart
DB_USER=cloudmart_admin
DB_PASSWORD=cloudmart_password

# AWS (used for S3 image uploads)
# In production, IAM task role credentials are used automatically.
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloudmart-images
